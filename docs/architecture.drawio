        <mxCell id="title" value="N O T A R Y  —  Full System Architecture" style="text;html=1;fillColor=none;strokeColor=none;fontFamily=Georgia;fontSize=23;align=left;verticalAlign=middle;whiteSpace=wrap;fontColor=#17493a;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="30.0" y="12.0" width="1150.0" height="34.0" as="geometry"/></mxCell><mxCell id="sub" value="Protocol-level transaction layer for AI tool calls  ·  ① QUOTE → ② CERTIFICATE → ③ ACT → ④ SEAL  ·  everything in the coloured bands runs in this repo today (hackathon MVP — not production)" style="text;html=1;fillColor=none;strokeColor=none;fontFamily=Georgia;fontSize=9.5;align=left;verticalAlign=middle;whiteSpace=wrap;fontColor=#4d5a52;" vertex="1" parent="1"><mxGeometry x="30.0" y="44.0" width="1420.0" height="18.0" as="geometry"/></mxCell><mxCell id="lg0" value="" style="rounded=0;arcSize=10;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#17493a;strokeWidth=1.3;dashed=0;fontFamily=Georgia;fontSize=9;align=left;verticalAlign=middle;spacingLeft=10;spacingRight=8;spacingTop=6;spacingBottom=6;fontColor=#1a2b26;" vertex="1" parent="1"><mxGeometry x="1372.0" y="11.0" width="24.0" height="9.0" as="geometry"/></mxCell><mxCell id="lgt0" value="core engine (this repo, runs today)" style="text;html=1;fillColor=none;strokeColor=none;fontFamily=Georgia;fontSize=8;align=left;verticalAlign=middle;whiteSpace=wrap;fontColor=#3d4741;" vertex="1" parent="1"><mxGeometry x="1402.0" y="8.0" width="565.0" height="14.0" as="geometry"/></mxCell><mxCell id="lg1" value="" style="rounded=0;arcSize=10;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#1f3a52;strokeWidth=1.3;dashed=0;fontFamily=Georgia;fontSize=9;align=left;verticalAlign=middle;spacingLeft=10;spacingRight=8;spacingTop=6;spacingBottom=6;fontColor=#1a2b26;" vertex="1" parent="1"><mxGeometry x="1372.0" y="25.5" width="24.0" height="9.0" as="geometry"/></mxCell><mxCell id="lgt1" value="seal / audit trail" style="text;html=1;fillColor=none;strokeColor=none;fontFamily=Georgia;fontSize=8;align=left;verticalAlign=middle;whiteSpace=wrap;fontColor=#3d4741;" vertex="1" parent="1"><mxGeometry x="1402.0" y="22.5" width="565.0" height="14.0" as="geometry"/></mxCell><mxCell id="lg2" value="" style="rounded=0;arcSize=10;whiteSpace=wrap;html=1;fillColor=#fdf1ea;strokeColor=#a4462b;strokeWidth=1.3;dashed=0;fontFamily=Georgia;fontSize=9;align=left;verticalAlign=middle;spacingLeft=10;spacingRight=8;spacingTop=6;spacingBottom=6;fontColor=#1a2b26;" vertex="1" parent="1"><mxGeometry x="1372.0" y="40.0" width="24.0" height="9.0" as="geometry"/></mxCell><mxCell id="lgt2" value="fault injection (the lies we catch)" style="text;html=1;fillColor=none;strokeColor=none;fontFamily=Georgia;fontSize=8;align=left;verticalAlign=middle;whiteSpace=wrap;fontColor=#3d4741;" vertex="1" parent="1"><mxGeometry x="1402.0" y="37.0" width="565.0" height="14.0" as="geometry"/></mxCell><mxCell id="lg3" value="" style="rounded=0;arcSize=10;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#6b6242;strokeWidth=1.3;dashed=1;fontFamily=Georgia;fontSize=9;align=left;verticalAlign=middle;spacingLeft=10;spacingRight=8;spacingTop=6;spacingBottom=6;fontColor=#1a2b26;" vertex="1" parent="1"><mxGeometry x="1372.0" y="54.5" width="24.0" height="9.0" as="geometry"/></mxCell><mxCell id="lgt3" value="offline models &amp; data" style="text;html=1;fillColor=none;strokeColor=none;fontFamily=Georgia;fontSize=8;align=left;verticalAlign=middle;whiteSpace=wrap;fontColor=#3d4741;" vertex="1" parent="1"><mxGeometry x="1402.0" y="51.5" width="565.0" height="14.0" as="geometry"/></mxCell><mxCell id="lg4" value="" style="rounded=0;arcSize=10;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#8f8b7d;strokeWidth=1.3;dashed=1;fontFamily=Georgia;fontSize=9;align=left;verticalAlign=middle;spacingLeft=10;spacingRight=8;spacingTop=6;spacingBottom=6;fontColor=#1a2b26;" vertex="1" parent="1"><mxGeometry x="1372.0" y="69.0" width="24.0" height="9.0" as="geometry"/></mxCell><mxCell id="lgt4" value="measured &amp; rejected — off the wire" style="text;html=1;fillColor=none;strokeColor=none;fontFamily=Georgia;fontSize=8;align=left;verticalAlign=middle;whiteSpace=wrap;fontColor=#3d4741;" vertex="1" parent="1"><mxGeometry x="1402.0" y="66.0" width="565.0" height="14.0" as="geometry"/></mxCell><mxCell id="lg5" value="" style="rounded=0;arcSize=10;whiteSpace=wrap;html=1;fillColor=#f0ede2;strokeColor=#9a958a;strokeWidth=1.3;dashed=1;fontFamily=Georgia;fontSize=9;align=left;verticalAlign=middle;spacingLeft=10;spacingRight=8;spacingTop=6;spacingBottom=6;fontColor=#1a2b26;" vertex="1" parent="1"><mxGeometry x="1372.0" y="83.5" width="24.0" height="9.0" as="geometry"/></mxCell><mxCell id="lgt5" value="not built — production projection" style="text;html=1;fillColor=none;strokeColor=none;fontFamily=Georgia;fontSize=8;align=left;verticalAlign=middle;whiteSpace=wrap;fontColor=#3d4741;" vertex="1" parent="1"><mxGeometry x="1402.0" y="80.5" width="565.0" height="14.0" as="geometry"/></mxCell><mxCell id="bandA" value="" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#fdfcf8;strokeColor=#d8d5c7;strokeWidth=1.2;dashed=0;fontFamily=Georgia;fontSize=9;align=left;verticalAlign=middle;spacingLeft=10;spacingRight=8;spacingTop=6;spacingBottom=6;fontColor=#1a2b26;" vertex="1" parent="1"><mxGeometry x="24.0" y="106.0" width="1952.0" height="130.0" as="geometry"/></mxCell><mxCell id="bandAa" value="" style="rounded=0;arcSize=10;whiteSpace=wrap;html=1;fillColor=#4a5850;strokeColor=#4a5850;strokeWidth=0;dashed=0;fontFamily=Georgia;fontSize=9;align=left;verticalAlign=middle;spacingLeft=10;spacingRight=8;spacingTop=6;spacingBottom=6;fontColor=#1a2b26;" vertex="1" parent="1"><mxGeometry x="24.0" y="106.0" width="7.0" height="130.0" as="geometry"/></mxCell><mxCell id="bandAt" value="ENTRY &amp;amp; INTEGRATION SURFACE  —  one engine, five doors" style="text;html=1;fillColor=none;strokeColor=none;fontFamily=Georgia;fontSize=11.5;align=left;verticalAlign=middle;whiteSpace=wrap;fontColor=#4a5850;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="44.0" y="111.0" width="1920.0" height="17.0" as="geometry"/></mxCell><mxCell id="A1" value="&lt;b&gt;React console&lt;/b&gt; (Vite · App.jsx)&lt;br&gt;&lt;br&gt;Judge-facing UI. Tabs:&lt;br&gt;&lt;b&gt;Demo Console&lt;/b&gt; (A/B baseline vs protected)&lt;br&gt;&lt;b&gt;Guided Run&lt;/b&gt; (5 steps, one click per call)&lt;br&gt;&lt;b&gt;Compiler Playground&lt;/b&gt; · &lt;b&gt;Receipts Ledger&lt;/b&gt; · &lt;b&gt;How It Works&lt;/b&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#4a5850;strokeWidth=1.6;dashed=0;fontFamily=Georgia;fontSize=8.5;align=left;verticalAlign=middle;spacingLeft=10;spacingRight=8;spacingTop=6;spacingBottom=6;fontColor=#1a2b26;" vertex="1" parent="1"><mxGeometry x="44.0" y="142.0" width="372.8" height="80.0" as="geometry"/></mxCell><mxCell id="A2" value="&lt;b&gt;HTTP facade :8787&lt;/b&gt;&lt;br&gt;server/notary-server.mjs&lt;br&gt;&lt;font style=&quot;font-family:Courier New&quot;&gt;POST /v1/compile&lt;br&gt;POST /v1/openai-tools&lt;br&gt;POST /v1/verify · GET /healthz&lt;/font&gt;&lt;br&gt;zero-dep node · HOST/PORT env, binds 127.0.0.1" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#4a5850;strokeWidth=1.6;dashed=0;fontFamily=Georgia;fontSize=8.5;align=left;verticalAlign=middle;spacingLeft=10;spacingRight=8;spacingTop=6;spacingBottom=6;fontColor=#1a2b26;" vertex="1" parent="1"><mxGeometry x="428.8" y="142.0" width="372.8" height="80.0" as="geometry"/></mxCell><mxCell id="A3" value="&lt;b&gt;MCP gate&lt;/b&gt;&lt;br&gt;integrations/mcp-proxy.mjs&lt;br&gt;&lt;font style=&quot;font-family:Courier New&quot;&gt;compileCatalog(tools/list, q)&lt;br&gt;→ { tools, cert, surface }&lt;br&gt;authorize(cert, id) // throws&lt;/font&gt;&lt;br&gt;fail-closed: unknown ids dropped, never forwarded" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#4a5850;strokeWidth=1.6;dashed=0;fontFamily=Georgia;fontSize=8.5;align=left;verticalAlign=middle;spacingLeft=10;spacingRight=8;spacingTop=6;spacingBottom=6;fontColor=#1a2b26;" vertex="1" parent="1"><mxGeometry x="813.6" y="142.0" width="372.8" height="80.0" as="geometry"/></mxCell><mxCell id="A4" value="&lt;b&gt;OpenAI tools adapter&lt;/b&gt;&lt;br&gt;integrations/openai-tools.mjs&lt;br&gt;&lt;font style=&quot;font-family:Courier New&quot;&gt;toOpenAITools(S)&lt;br&gt;→ chat.completions tools[]&lt;br&gt;fromOpenAIToolName()&lt;/font&gt;&lt;br&gt;param strings → JSON Schema · 0 deps" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#4a5850;strokeWidth=1.6;dashed=0;fontFamily=Georgia;fontSize=8.5;align=left;verticalAlign=middle;spacingLeft=10;spacingRight=8;spacingTop=6;spacingBottom=6;fontColor=#1a2b26;" vertex="1" parent="1"><mxGeometry x="1198.4" y="142.0" width="372.8" height="80.0" as="geometry"/></mxCell><mxCell id="A5" value="&lt;b&gt;Scripts / CI&lt;/b&gt; — scripts/*.mjs&lt;br&gt;&lt;font style=&quot;font-family:Courier New&quot;&gt;npm run train · calibrate&lt;br&gt;npm run eval  (+ exact oracle)&lt;br&gt;npm test 53/53 · npm run smoke&lt;br&gt;node scripts/ui-check.mjs&lt;/font&gt;&lt;br&gt;headless Playwright end-to-end" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#4a5850;strokeWidth=1.6;dashed=0;fontFamily=Georgia;fontSize=8.5;align=left;verticalAlign=middle;spacingLeft=10;spacingRight=8;spacingTop=6;spacingBottom=6;fontColor=#1a2b26;" vertex="1" parent="1"><mxGeometry x="1583.2" y="142.0" width="372.8" height="80.0" as="geometry"/></mxCell><mxCell id="bandB" value="" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#fdfcf8;strokeColor=#d8d5c7;strokeWidth=1.2;dashed=0;fontFamily=Georgia;fontSize=9;align=left;verticalAlign=middle;spacingLeft=10;spacingRight=8;spacingTop=6;spacingBottom=6;fontColor=#1a2b26;" vertex="1" parent="1"><mxGeometry x="24.0" y="254.0" width="1952.0" height="196.0" as="geometry"/></mxCell><mxCell id="bandBa" value="" style="rounded=0;arcSize=10;whiteSpace=wrap;html=1;fillColor=#17493a;strokeColor=#17493a;strokeWidth=0;dashed=0;fontFamily=Georgia;fontSize=9;align=left;verticalAlign=middle;spacingLeft=10;spacingRight=8;spacingTop=6;spacingBottom=6;fontColor=#1a2b26;" vertex="1" parent="1"><mxGeometry x="24.0" y="254.0" width="7.0" height="196.0" as="geometry"/></mxCell><mxCell id="bandBt" value="① QUOTE — compile the surface   ·   &quot;which tools may the model even see?&quot;" style="text;html=1;fillColor=none;strokeColor=none;fontFamily=Georgia;fontSize=11.5;align=left;verticalAlign=middle;whiteSpace=wrap;fontColor=#17493a;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="44.0" y="259.0" width="1920.0" height="17.0" as="geometry"/></mxCell><mxCell id="B1" value="&lt;b&gt;TF-IDF + classic scorer&lt;/b&gt; — SHIPPED&lt;br&gt;text.js · similarity.js · cos^1.15 · coverage · prior · service-grounding boost · pooled; fail-closed (junk → 0.0000)&lt;br&gt;&lt;b&gt;100% held-out selection recall @ ~6 tools&lt;/b&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#17493a;strokeWidth=2.0;dashed=0;fontFamily=Georgia;fontSize=8.5;align=left;verticalAlign=middle;spacingLeft=10;spacingRight=8;spacingTop=6;spacingBottom=6;fontColor=#1a2b26;" vertex="1" parent="1"><mxGeometry x="73.0" y="292.0" width="470.0" height="67.0" as="geometry"/></mxCell><mxCell id="B2" value="&lt;b&gt;Challengers — measured, REJECTED&lt;/b&gt;&lt;br&gt;&lt;b&gt;ℓLR 11-feat&lt;/b&gt; 92.3 nDCG5 / 92.4 MRR (CV +0.8) — benchmarked challenger only&lt;br&gt;&lt;b&gt;BM25F&lt;/b&gt; 72.2 nDCG5 ✗  ·  &lt;b&gt;hybrid 40/50/60&lt;/b&gt; ≡ classic ✗  ·  &lt;b&gt;never wired&lt;/b&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#8f8b7d;strokeWidth=1.4;dashed=1;fontFamily=Georgia;fontSize=8.5;align=left;verticalAlign=middle;spacingLeft=10;spacingRight=8;spacingTop=6;spacingBottom=6;fontColor=#1a2b26;" vertex="1" parent="1"><mxGeometry x="73.0" y="369.0" width="470.0" height="67.0" as="geometry"/></mxCell><mxCell id="B3" value="&lt;b&gt;BTSS COMPILER&lt;/b&gt; — selector.js · the core&lt;br&gt;maximise F(S) = Σ r(t|q) − λ·Σ σ(t,t′)  s.t. Σ d(t) ≤ B (900 tok)&lt;br&gt;pool cutoff (classic .15 / learned .171)  ·  &lt;b&gt;λ_max clamp&lt;/b&gt; — r ≥ λ·Σσ ⇒ F monotone, Sviridenko&lt;br&gt;cost-benefit greedy · incremental penalties · Float32 σ-matrix · &lt;b&gt;≤3-seed enumeration (469 seeds)&lt;/b&gt;&lt;br&gt;δ = 0.05 marginal floor  ·  &lt;b&gt;pin / block&lt;/b&gt; honoured under the hard budget&lt;br&gt;&lt;b&gt;F ≥ (1−1/e)·OPT · measured F/F* = 99.86%&lt;/b&gt; (exact B&amp;amp;B oracle, 65 gold queries) · ≈ 9 ms warm" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#f3f8f4;strokeColor=#17493a;strokeWidth=2.4;dashed=0;fontFamily=Georgia;fontSize=8.5;align=left;verticalAlign=middle;spacingLeft=10;spacingRight=8;spacingTop=6;spacingBottom=6;fontColor=#1a2b26;" vertex="1" parent="1"><mxGeometry x="555.0" y="292.0" width="700.0" height="144.0" as="geometry"/></mxCell><mxCell id="B4" value="&lt;b&gt;COST CERTIFICATE&lt;/b&gt; — certificate.js · cert-calibration.js&lt;br&gt;C(S) = Σ&lt;sub&gt;t∈S&lt;/sub&gt; d(t)  +  Σ&lt;sub&gt;t∈S&lt;/sub&gt; Q&lt;sub&gt;t&lt;/sub&gt;(1 − α/|S|)&lt;br&gt;lognormal returns, p95-calibrated · per-tool confidence 1 − α/|S|&lt;br&gt;&lt;b&gt;Bonferroni union bound · α = 0.05&lt;/b&gt; — no independence assumed&lt;br&gt;conformal tightening ×1.02→×0.31 (n=1→8) · 4.98% held-out breach&lt;br&gt;&lt;b&gt;the guarantee attaches to the BOUND — never to the estimate&lt;/b&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#17493a;strokeWidth=2.0;dashed=0;fontFamily=Georgia;fontSize=8.5;align=left;verticalAlign=middle;spacingLeft=10;spacingRight=8;spacingTop=6;spacingBottom=6;fontColor=#1a2b26;" vertex="1" parent="1"><mxGeometry x="1267.0" y="292.0" width="660.0" height="144.0" as="geometry"/></mxCell><mxCell id="bandC" value="" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#fdfcf8;strokeColor=#d8d5c7;strokeWidth=1.2;dashed=0;fontFamily=Georgia;fontSize=9;align=left;verticalAlign=middle;spacingLeft=10;spacingRight=8;spacingTop=6;spacingBottom=6;fontColor=#1a2b26;" vertex="1" parent="1"><mxGeometry x="24.0" y="470.0" width="1952.0" height="200.0" as="geometry"/></mxCell><mxCell id="bandCa" value="" style="rounded=0;arcSize=10;whiteSpace=wrap;html=1;fillColor=#a4462b;strokeColor=#a4462b;strokeWidth=0;dashed=0;fontFamily=Georgia;fontSize=9;align=left;verticalAlign=middle;spacingLeft=10;spacingRight=8;spacingTop=6;spacingBottom=6;fontColor=#1a2b26;" vertex="1" parent="1"><mxGeometry x="24.0" y="470.0" width="7.0" height="200.0" as="geometry"/></mxCell><mxCell id="bandCt" value="②③ ACT — certified execution   ·   &quot;one call, one click, every write read back&quot;" style="text;html=1;fillColor=none;strokeColor=none;fontFamily=Georgia;fontSize=11.5;align=left;verticalAlign=middle;whiteSpace=wrap;fontColor=#a4462b;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="44.0" y="475.0" width="1920.0" height="17.0" as="geometry"/></mxCell><mxCell id="C1" value="&lt;b&gt;Deterministic planner&lt;/b&gt; — planner.js&lt;br&gt;&lt;b&gt;NO LLM in the loop&lt;/b&gt;&lt;br&gt;intent rules → concrete tool + params FROM the certified surface&lt;br&gt;reads (stage 1) → writes (stage 2)&lt;br&gt;content composed across steps: Drive → Slack → Notion → CRM&lt;br&gt;no intent ⇒ &lt;b&gt;empty plan ⇒ zero calls&lt;/b&gt; (fail closed)" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#a4462b;strokeWidth=1.8;dashed=0;fontFamily=Georgia;fontSize=8;align=left;verticalAlign=middle;spacingLeft=10;spacingRight=8;spacingTop=6;spacingBottom=6;fontColor=#1a2b26;" vertex="1" parent="1"><mxGeometry x="41.0" y="508.0" width="368.0" height="148.0" as="geometry"/></mxCell><mxCell id="C2" value="&lt;b&gt;Agent / guided session&lt;/b&gt;&lt;br&gt;agent.js &lt;font style=&quot;font-family:Courier New&quot;&gt;runTask()&lt;/font&gt; · guided-session.js&lt;br&gt;Demo Console A/B: &lt;b&gt;BASELINE&lt;/b&gt; (&quot;Done!&quot; on 200 OK) vs &lt;b&gt;PROTECTED&lt;/b&gt; (this engine)&lt;br&gt;Guided Run: one deliberate click per action · fault armed · live what-was-chosen state&lt;br&gt;bounded retry &lt;b&gt;≤ 2&lt;/b&gt; → then human handoff" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#a4462b;strokeWidth=1.8;dashed=0;fontFamily=Georgia;fontSize=8;align=left;verticalAlign=middle;spacingLeft=10;spacingRight=8;spacingTop=6;spacingBottom=6;fontColor=#1a2b26;" vertex="1" parent="1"><mxGeometry x="421.0" y="508.0" width="400.0" height="148.0" as="geometry"/></mxCell><mxCell id="C3" value="&lt;b&gt;Idempotency store&lt;/b&gt; — idempotency.js&lt;br&gt;key = SHA-256(stableStringify{task, tool, params})&lt;br&gt;&lt;b&gt;CONFIRMED&lt;/b&gt; → replay served from cache; the side effect &lt;b&gt;never happens twice&lt;/b&gt;&lt;br&gt;&lt;b&gt;CONTRADICTED&lt;/b&gt; → key released for the bounded retry&lt;br&gt;inflight collision refused · localStorage / Map" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#a4462b;strokeWidth=1.8;dashed=0;fontFamily=Georgia;fontSize=8;align=left;verticalAlign=middle;spacingLeft=10;spacingRight=8;spacingTop=6;spacingBottom=6;fontColor=#1a2b26;" vertex="1" parent="1"><mxGeometry x="833.0" y="508.0" width="356.0" height="148.0" as="geometry"/></mxCell><mxCell id="C4" value="&lt;b&gt;MCP backends + fault injection&lt;/b&gt;&lt;br&gt;world.js — deterministic mock, wires all 86 tools&lt;br&gt;&lt;b&gt;silentNoOp&lt;/b&gt;: first write swallowed → &lt;b&gt;HTTP 200 OK, nothing lands&lt;/b&gt;&lt;br&gt;scores the exact failure class Notary exists to catch&lt;br&gt;live world-state counters (Slack · Notion · CRM · …)" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#fdf1ea;strokeColor=#a4462b;strokeWidth=2.2;dashed=0;fontFamily=Georgia;fontSize=8;align=left;verticalAlign=middle;spacingLeft=10;spacingRight=8;spacingTop=6;spacingBottom=6;fontColor=#1a2b26;" vertex="1" parent="1"><mxGeometry x="1201.0" y="508.0" width="376.0" height="148.0" as="geometry"/></mxCell><mxCell id="C5" value="&lt;b&gt;READ-BACK VERIFIER&lt;/b&gt; — verifier.js&lt;br&gt;effect contract per write: &lt;b&gt;pre · φ_post · readback&lt;/b&gt;&lt;br&gt;re-reads real state after the call; never trusts the body&lt;br&gt;&lt;b&gt;200 OK ≠ success&lt;/b&gt;&lt;br&gt;CONTRADICTED ⇒ auto-retry (≤ 2) ⇒ CONFIRMED · falseSuccessCaught++" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#fdf1ea;strokeColor=#a4462b;strokeWidth=2.2;dashed=0;fontFamily=Georgia;fontSize=8;align=left;verticalAlign=middle;spacingLeft=10;spacingRight=8;spacingTop=6;spacingBottom=6;fontColor=#1a2b26;" vertex="1" parent="1"><mxGeometry x="1589.0" y="508.0" width="370.0" height="148.0" as="geometry"/></mxCell><mxCell id="bandD" value="" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#fdfcf8;strokeColor=#d8d5c7;strokeWidth=1.2;dashed=0;fontFamily=Georgia;fontSize=9;align=left;verticalAlign=middle;spacingLeft=10;spacingRight=8;spacingTop=6;spacingBottom=6;fontColor=#1a2b26;" vertex="1" parent="1"><mxGeometry x="24.0" y="690.0" width="1952.0" height="150.0" as="geometry"/></mxCell><mxCell id="bandDa" value="" style="rounded=0;arcSize=10;whiteSpace=wrap;html=1;fillColor=#1f3a52;strokeColor=#1f3a52;strokeWidth=0;dashed=0;fontFamily=Georgia;fontSize=9;align=left;verticalAlign=middle;spacingLeft=10;spacingRight=8;spacingTop=6;spacingBottom=6;fontColor=#1a2b26;" vertex="1" parent="1"><mxGeometry x="24.0" y="690.0" width="7.0" height="150.0" as="geometry"/></mxCell><mxCell id="bandDt" value="④ SEAL — receipt, audit, learning loop   ·   &quot;nothing moves without both&quot;" style="text;html=1;fillColor=none;strokeColor=none;fontFamily=Georgia;fontSize=11.5;align=left;verticalAlign=middle;whiteSpace=wrap;fontColor=#1f3a52;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="44.0" y="695.0" width="1920.0" height="17.0" as="geometry"/></mxCell><mxCell id="D2" value="&lt;b&gt;FSR POSTERIOR&lt;/b&gt; — fsr.js&lt;br&gt;per-tool False-Success-Rate · conjugate Beta(1,1) prior&lt;br&gt;p̂ = (f+1)/(n+2) · &lt;b&gt;Wilson 95% score interval&lt;/b&gt;&lt;br&gt;14-day half-life decay — tracks &lt;i&gt;current&lt;/i&gt; behaviour, not lifetime history&lt;br&gt;Class: &quot;200 OK ∧ no state change&quot;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#1f3a52;strokeWidth=2.0;dashed=0;fontFamily=Georgia;fontSize=8.5;align=left;verticalAlign=middle;spacingLeft=10;spacingRight=8;spacingTop=6;spacingBottom=6;fontColor=#1a2b26;" vertex="1" parent="1"><mxGeometry x="88.0" y="726.0" width="460.0" height="100.0" as="geometry"/></mxCell><mxCell id="D1" value="&lt;b&gt;SIGNED, HASH-CHAINED RECEIPT&lt;/b&gt; — receipts.js&lt;br&gt;SHA-256(stableStringify{ surface, certificate, every call + params, verdicts, budget, FSR })&lt;br&gt;→ &lt;font style=&quot;font-family:Courier New&quot;&gt;rcpt_…&lt;/font&gt; · chained via prevHash (genesis: none) · ephemeral session key (prod: KMS/HSM)&lt;br&gt;tamper a single byte anywhere — &lt;b&gt;verifyChain()&lt;/b&gt; breaks the chain" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#1f3a52;strokeWidth=2.0;dashed=0;fontFamily=Georgia;fontSize=8.5;align=left;verticalAlign=middle;spacingLeft=10;spacingRight=8;spacingTop=6;spacingBottom=6;fontColor=#1a2b26;" vertex="1" parent="1"><mxGeometry x="560.0" y="726.0" width="640.0" height="100.0" as="geometry"/></mxCell><mxCell id="D3" value="&lt;b&gt;Immutable audit trail&lt;/b&gt;&lt;br&gt;Receipts Ledger UI — verdict, chain status, surface, cost, FSR per sealed receipt&lt;br&gt;localStorage idempotency store survives reloads (&quot;the ledger remembers&quot;)&lt;br&gt;structured logs (logger.js): ring buffer in-browser · 1 MB-rotated JSONL on node (logs/facade.jsonl)&lt;br&gt;UI-verified: guided run seals, &lt;b&gt;chain valid&lt;/b&gt;, false-success counter = 1 on the injected fault" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#1f3a52;strokeWidth=1.8;dashed=0;fontFamily=Georgia;fontSize=8.5;align=left;verticalAlign=middle;spacingLeft=10;spacingRight=8;spacingTop=6;spacingBottom=6;fontColor=#1a2b26;" vertex="1" parent="1"><mxGeometry x="1212.0" y="726.0" width="700.0" height="100.0" as="geometry"/></mxCell><mxCell id="bandE" value="" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#fdfcf8;strokeColor=#d8d5c7;strokeWidth=1.2;dashed=0;fontFamily=Georgia;fontSize=9;align=left;verticalAlign=middle;spacingLeft=10;spacingRight=8;spacingTop=6;spacingBottom=6;fontColor=#1a2b26;" vertex="1" parent="1"><mxGeometry x="24.0" y="860.0" width="1952.0" height="160.0" as="geometry"/></mxCell><mxCell id="bandEa" value="" style="rounded=0;arcSize=10;whiteSpace=wrap;html=1;fillColor=#6b6242;strokeColor=#6b6242;strokeWidth=0;dashed=0;fontFamily=Georgia;fontSize=9;align=left;verticalAlign=middle;spacingLeft=10;spacingRight=8;spacingTop=6;spacingBottom=6;fontColor=#1a2b26;" vertex="1" parent="1"><mxGeometry x="24.0" y="860.0" width="7.0" height="160.0" as="geometry"/></mxCell><mxCell id="bandEt" value="OFFLINE MODELS &amp;amp; DATA  —  every number above traces to here (seeded, reproducible)" style="text;html=1;fillColor=none;strokeColor=none;fontFamily=Georgia;fontSize=11.5;align=left;verticalAlign=middle;whiteSpace=wrap;fontColor=#6b6242;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="44.0" y="865.0" width="1920.0" height="17.0" as="geometry"/></mxCell><mxCell id="E1" value="&lt;b&gt;registry.js&lt;/b&gt; — the world, declared&lt;br&gt;&lt;b&gt;86 MCP tools&lt;/b&gt; · descriptor cost (tokens) · p95 return tokens&lt;br&gt;prior · read/write kind · &lt;b&gt;effect contracts&lt;/b&gt; (pre · post · readback)&lt;br&gt;σ(t,t′): token Jaccard × service × desc-trap model · hand-calibrated pairs" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#6b6242;strokeWidth=1.6;dashed=0;fontFamily=Georgia;fontSize=8;align=left;verticalAlign=middle;spacingLeft=10;spacingRight=8;spacingTop=6;spacingBottom=6;fontColor=#1a2b26;" vertex="1" parent="1"><mxGeometry x="78.0" y="896.0" width="350.0" height="110.0" as="geometry"/></mxCell><mxCell id="E2" value="&lt;b&gt;gold.jsonl&lt;/b&gt;&lt;br&gt;&lt;b&gt;65 supervision queries&lt;/b&gt;&lt;br&gt;positives = required tools&lt;br&gt;72 pos / 5,518 neg&lt;br&gt;(distant supervision, closed registry)" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#6b6242;strokeWidth=1.6;dashed=0;fontFamily=Georgia;fontSize=8;align=left;verticalAlign=middle;spacingLeft=10;spacingRight=8;spacingTop=6;spacingBottom=6;fontColor=#1a2b26;" vertex="1" parent="1"><mxGeometry x="440.0" y="896.0" width="268.0" height="110.0" as="geometry"/></mxCell><mxCell id="E3" value="&lt;b&gt;train.mjs → model-params.js&lt;/b&gt;&lt;br&gt;logreg · 11 features (cos·cov·prior·name/serviceHit·idfCov·charCos·bigramCov)&lt;br&gt;seeded by-query 80/20 split · L2 3e-3 · pos-weight 4 · 4,000 epochs&lt;br&gt;pool cutoff from train negatives (FPR ≤ 2%) → &lt;b&gt;0.171&lt;/b&gt;&lt;br&gt;challenger only — production ships classic" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#6b6242;strokeWidth=1.6;dashed=0;fontFamily=Georgia;fontSize=8;align=left;verticalAlign=middle;spacingLeft=10;spacingRight=8;spacingTop=6;spacingBottom=6;fontColor=#1a2b26;" vertex="1" parent="1"><mxGeometry x="720.0" y="896.0" width="396.0" height="110.0" as="geometry"/></mxCell><mxCell id="E4" value="&lt;b&gt;calibrate.mjs → cert-calibration.js&lt;/b&gt;&lt;br&gt;40,000 synthetic episodes per n ∈ [1..8]&lt;br&gt;per-size split-conformal inflation on the stochastic tail&lt;br&gt;verified on 20,000 held-out episodes&lt;br&gt;&lt;b&gt;4.98% breach at α = 0.05&lt;/b&gt; (Bonferroni: conservative)" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#6b6242;strokeWidth=1.6;dashed=0;fontFamily=Georgia;fontSize=8;align=left;verticalAlign=middle;spacingLeft=10;spacingRight=8;spacingTop=6;spacingBottom=6;fontColor=#1a2b26;" vertex="1" parent="1"><mxGeometry x="1128.0" y="896.0" width="396.0" height="110.0" as="geometry"/></mxCell><mxCell id="E5" value="&lt;b&gt;eval.mjs · cv-features.mjs&lt;/b&gt;&lt;br&gt;held-out nDCG / MRR by-query · selection recall (classic 100% test)&lt;br&gt;&lt;b&gt;exact branch-and-bound oracle&lt;/b&gt; → mean F/F* = &lt;b&gt;99.86%&lt;/b&gt;&lt;br&gt;5-fold CV (+0.8, noise → kept, modestly) · junk fail-closed&lt;br&gt;BM25F verdict · relative claims only (n=13 test)" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#6b6242;strokeWidth=1.6;dashed=0;fontFamily=Georgia;fontSize=8;align=left;verticalAlign=middle;spacingLeft=10;spacingRight=8;spacingTop=6;spacingBottom=6;fontColor=#1a2b26;" vertex="1" parent="1"><mxGeometry x="1536.0" y="896.0" width="386.0" height="110.0" as="geometry"/></mxCell><mxCell id="bandF" value="" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#fdfcf8;strokeColor=#d8d5c7;strokeWidth=1.2;dashed=0;fontFamily=Georgia;fontSize=9;align=left;verticalAlign=middle;spacingLeft=10;spacingRight=8;spacingTop=6;spacingBottom=6;fontColor=#1a2b26;" vertex="1" parent="1"><mxGeometry x="24.0" y="1040.0" width="1952.0" height="128.0" as="geometry"/></mxCell><mxCell id="bandFa" value="" style="rounded=0;arcSize=10;whiteSpace=wrap;html=1;fillColor=#9a958a;strokeColor=#9a958a;strokeWidth=0;dashed=0;fontFamily=Georgia;fontSize=9;align=left;verticalAlign=middle;spacingLeft=10;spacingRight=8;spacingTop=6;spacingBottom=6;fontColor=#1a2b26;" vertex="1" parent="1"><mxGeometry x="24.0" y="1040.0" width="7.0" height="128.0" as="geometry"/></mxCell><mxCell id="bandFt" value="NOT BUILT — PRODUCTION PROJECTION  (docs/ARCHITECTURE.md §8 — the pitch, not the repo)" style="text;html=1;fillColor=none;strokeColor=none;fontFamily=Georgia;fontSize=11.5;align=left;verticalAlign=middle;whiteSpace=wrap;fontColor=#9a958a;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="44.0" y="1045.0" width="1920.0" height="17.0" as="geometry"/></mxCell><mxCell id="F0" value="&lt;b&gt;Bedrock Converse&lt;/b&gt;&lt;br&gt;reasoning" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#f0ede2;strokeColor=#9a958a;strokeWidth=1.2;dashed=1;fontFamily=Georgia;fontSize=7.5;align=left;verticalAlign=middle;spacingLeft=10;spacingRight=8;spacingTop=6;spacingBottom=6;fontColor=#1a2b26;" vertex="1" parent="1"><mxGeometry x="44.0" y="1072.0" width="372.8" height="36.0" as="geometry"/></mxCell><mxCell id="F1" value="&lt;b&gt;Guardrails&lt;/b&gt;&lt;br&gt;input-side injection defence" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#f0ede2;strokeColor=#9a958a;strokeWidth=1.2;dashed=1;fontFamily=Georgia;fontSize=7.5;align=left;verticalAlign=middle;spacingLeft=10;spacingRight=8;spacingTop=6;spacingBottom=6;fontColor=#1a2b26;" vertex="1" parent="1"><mxGeometry x="428.8" y="1072.0" width="372.8" height="36.0" as="geometry"/></mxCell><mxCell id="F2" value="&lt;b&gt;OpenSearch Serverless&lt;/b&gt;&lt;br&gt;ANN descriptors · ≤ 9 ms" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#f0ede2;strokeColor=#9a958a;strokeWidth=1.2;dashed=1;fontFamily=Georgia;fontSize=7.5;align=left;verticalAlign=middle;spacingLeft=10;spacingRight=8;spacingTop=6;spacingBottom=6;fontColor=#1a2b26;" vertex="1" parent="1"><mxGeometry x="813.6" y="1072.0" width="372.8" height="36.0" as="geometry"/></mxCell><mxCell id="F3" value="&lt;b&gt;DynamoDB&lt;/b&gt;&lt;br&gt;registry · calibration · hash-chain log" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#f0ede2;strokeColor=#9a958a;strokeWidth=1.2;dashed=1;fontFamily=Georgia;fontSize=7.5;align=left;verticalAlign=middle;spacingLeft=10;spacingRight=8;spacingTop=6;spacingBottom=6;fontColor=#1a2b26;" vertex="1" parent="1"><mxGeometry x="1198.4" y="1072.0" width="372.8" height="36.0" as="geometry"/></mxCell><mxCell id="F4" value="&lt;b&gt;Fargate&lt;/b&gt;&lt;br&gt;stateless compiler + verifier" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#f0ede2;strokeColor=#9a958a;strokeWidth=1.2;dashed=1;fontFamily=Georgia;fontSize=7.5;align=left;verticalAlign=middle;spacingLeft=10;spacingRight=8;spacingTop=6;spacingBottom=6;fontColor=#1a2b26;" vertex="1" parent="1"><mxGeometry x="1583.2" y="1072.0" width="372.8" height="36.0" as="geometry"/></mxCell><mxCell id="F5" value="&lt;b&gt;Step Functions&lt;/b&gt;&lt;br&gt;deterministic replay of verified plans" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#f0ede2;strokeColor=#9a958a;strokeWidth=1.2;dashed=1;fontFamily=Georgia;fontSize=7.5;align=left;verticalAlign=middle;spacingLeft=10;spacingRight=8;spacingTop=6;spacingBottom=6;fontColor=#1a2b26;" vertex="1" parent="1"><mxGeometry x="44.0" y="1116.0" width="372.8" height="36.0" as="geometry"/></mxCell><mxCell id="F6" value="&lt;b&gt;EventBridge&lt;/b&gt;&lt;br&gt;scheduled verified digests" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#f0ede2;strokeColor=#9a958a;strokeWidth=1.2;dashed=1;fontFamily=Georgia;fontSize=7.5;align=left;verticalAlign=middle;spacingLeft=10;spacingRight=8;spacingTop=6;spacingBottom=6;fontColor=#1a2b26;" vertex="1" parent="1"><mxGeometry x="428.8" y="1116.0" width="372.8" height="36.0" as="geometry"/></mxCell><mxCell id="F7" value="&lt;b&gt;CloudWatch&lt;/b&gt;&lt;br&gt;α-breach · FSR p95 alarms" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#f0ede2;strokeColor=#9a958a;strokeWidth=1.2;dashed=1;fontFamily=Georgia;fontSize=7.5;align=left;verticalAlign=middle;spacingLeft=10;spacingRight=8;spacingTop=6;spacingBottom=6;fontColor=#1a2b26;" vertex="1" parent="1"><mxGeometry x="813.6" y="1116.0" width="372.8" height="36.0" as="geometry"/></mxCell><mxCell id="F8" value="&lt;b&gt;Cognito&lt;/b&gt;&lt;br&gt;tenant scoping" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColo